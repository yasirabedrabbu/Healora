// Healora - Prisma schema mirroring Handoff.md §13 (data model draft).
// PostgreSQL + PostGIS (coords via Decimal pair until PostGIS extension) + pgvector-ready.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Users & identity ──────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?  @unique
  role      Role     @default(PATIENT)
  name      String?
  bloodGroup String?
  area      String?
  createdAt DateTime @default(now())

  doctor              Doctor?
  patientRecords      MedicalRecord[]
  recordSharesGiven   RecordShare[]
  accessLogs          AccessLog[]
  appointments        Appointment[]        @relation("PatientAppointments")
  prescriptionsIssued Prescription[]       @relation("IssuedPrescriptions")
  prescriptionsReceived Prescription[]     @relation("ReceivedPrescriptions")
  bloodDonor          BloodDonor?
  bloodRequests       BloodRequest[]
  reportsMade         Report[]
  aiSessions          AiSession[]
  settings            UserSettings?
  notifications       Notification[]
  familyMembers       FamilyMember[]       @relation("FamilyPatient")
  linkedFamilyMember  FamilyMember?        @relation("FamilyLinkedUser")
  labBookings         LabBooking[]
  pharmacyOrders      PharmacyOrder[]
  ambulanceBookings   AmbulanceBooking[]
  queueTickets        QueueTicket[]        @relation("PatientQueueTickets")
  consultationMessages ConsultationMessage[]
  refillRequests      RefillRequest[]
  pushTokens          PushToken[]
  ownedHospital       Hospital?            @relation("HospitalOwner")
  ownedLab            Lab?                 @relation("LabOwner")
  ownedPharmacy       Pharmacy?            @relation("PharmacyOwner")
}

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL
  LAB
  PHARMACY
  ADMIN
}

// ── Doctors & verification ────────────────────────────────────────
model Doctor {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id])
  bmdcNo         String        @unique
  specialty      String
  degrees        String
  fee            Int
  languages      String[]
  modes          String[]
  verifiedStatus VerifiedStatus @default(PENDING)
  rating         Float         @default(0)
  nextSlot       String?
  verifiedAt     DateTime?

  documents      DoctorDocument[]
  appointments   Appointment[]   @relation("DoctorAppointments")
  schedules      Schedule[]
  queueTickets   QueueTicket[]
}

enum VerifiedStatus {
  PENDING
  APPROVED
  REJECTED
}

model DoctorDocument {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])
  type     String // bmdc | nid | selfie | certificate
  fileUrl  String
  status   VerifiedStatus @default(PENDING)
}

// ── Facilities ────────────────────────────────────────────────────
model Hospital {
  id             String         @id @default(cuid())
  name           String
  address        String
  lat            Decimal        @db.Decimal(9, 6)
  lng            Decimal        @db.Decimal(9, 6)
  licenseNo      String         @unique
  verifiedStatus VerifiedStatus @default(PENDING)
  ownerId        String?        @unique
  owner          User?          @relation("HospitalOwner", fields: [ownerId], references: [id])

  beds         HospitalBed[]
  ambulances   Ambulance[]
  queueTickets QueueTicket[]
}

model HospitalBed {
  id         String   @id @default(cuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  type       String // general | icu | oxygen
  total      Int
  available  Int
  updatedAt  DateTime @updatedAt

  @@unique([hospitalId, type])
}

model Lab {
  id             String         @id @default(cuid())
  name           String
  address        String?
  lat            Decimal        @db.Decimal(9, 6)
  lng            Decimal        @db.Decimal(9, 6)
  licenseNo      String         @unique
  verifiedStatus VerifiedStatus @default(PENDING)
  ownerId        String?        @unique
  owner          User?          @relation("LabOwner", fields: [ownerId], references: [id])

  tests    LabTest[]
  bookings LabBooking[]
}

model Pharmacy {
  id             String         @id @default(cuid())
  name           String
  address        String?
  lat            Decimal        @db.Decimal(9, 6)
  lng            Decimal        @db.Decimal(9, 6)
  dgdaNo         String         @unique
  verifiedStatus VerifiedStatus @default(PENDING)
  ownerId        String?        @unique
  owner          User?          @relation("PharmacyOwner", fields: [ownerId], references: [id])

  orders          PharmacyOrder[]
  refillRequests  RefillRequest[]
}

// ── Appointments & consultations ─────────────────────────────────
model Appointment {
  id        String  @id @default(cuid())
  patientId String
  doctorId  String
  patient   User    @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor    Doctor  @relation("DoctorAppointments", fields: [doctorId], references: [id])
  slot      DateTime
  mode      String // video | audio | chat | chamber
  status    AppointmentStatus @default(BOOKED)
  paymentId String?

  createdAt DateTime @default(now())
  consultation Consultation?
  payment      Payment?
  review       Review?

  @@index([doctorId, slot])
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Consultation {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  startedAt     DateTime?
  endedAt       DateTime?
  notes         String?     @db.Text
  messages      ConsultationMessage[]
}

// ── Prescriptions ─────────────────────────────────────────────────
model Prescription {
  id             String   @id @default(cuid())
  consultationId String?
  doctorId       String
  patientId      String
  doctor         User     @relation("IssuedPrescriptions", fields: [doctorId], references: [id])
  patient        User     @relation("ReceivedPrescriptions", fields: [patientId], references: [id])
  hash           String   @unique
  qrToken        String   @unique
  validUntil     DateTime
  status         PrescriptionStatus @default(ACTIVE)
  createdAt      DateTime @default(now())

  items          PrescriptionItem[]
  pharmacyOrder  PharmacyOrder?
  refillRequests RefillRequest[]
}

enum PrescriptionStatus {
  ACTIVE
  DISPENSED
  EXPIRED
}

model PrescriptionItem {
  id             String      @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicineId     String
  medicine       Medicine    @relation(fields: [medicineId], references: [id])
  dose           String
  duration       String
}

model Medicine {
  id          String @id @default(cuid())
  brandName   String
  genericName String
  strength    String
  form        String

  items PrescriptionItem[]
}

// ── Records, shares, access log ───────────────────────────────────
model MedicalRecord {
  id        String  @id @default(cuid())
  patientId String
  patient   User    @relation(fields: [patientId], references: [id])
  type      String // prescription_scan | lab_report | note
  fileUrl   String
  encrypted Boolean @default(true)
  createdAt DateTime @default(now())

  shares RecordShare[]
  logs   AccessLog[]
}

model RecordShare {
  id        String       @id @default(cuid())
  recordId  String
  record    MedicalRecord @relation(fields: [recordId], references: [id])
  granteeId String
  grantee   User         @relation(fields: [granteeId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
}

model AccessLog {
  id         String  @id @default(cuid())
  recordId   String
  record     MedicalRecord @relation(fields: [recordId], references: [id])
  accessedBy String
  user       User    @relation(fields: [accessedBy], references: [id])
  action     String // view | download | share | revoke
  accessedAt DateTime @default(now())
}

// ── Payments ──────────────────────────────────────────────────────
model Payment {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  amount        Int
  gateway       String // bkash | nagad | card
  gatewayRef    String?
  status        PaymentStatus @default(HOLD)
  releasedAt    DateTime?
}

enum PaymentStatus {
  HOLD
  RELEASED
  REFUNDED
}

// ── Blood community ───────────────────────────────────────────────
model BloodDonor {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id])
  bloodGroup     String
  areaLat        Decimal @db.Decimal(9, 6)
  areaLng        Decimal @db.Decimal(9, 6)
  lastDonatedAt  DateTime?
  verified       Boolean @default(false)
}

model BloodRequest {
  id          String  @id @default(cuid())
  requesterId String
  requester   User    @relation(fields: [requesterId], references: [id])
  bloodGroup  String
  hospitalId  String?
  urgency     String  // routine | urgent | critical
  note        String? @db.Text
  status      String  @default("open")
  createdAt   DateTime @default(now())
}

// ── Trust & audit ─────────────────────────────────────────────────
model Review {
  id            String     @id @default(cuid())
  appointmentId String     @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int
  text          String?    @db.Text
  verified      Boolean    @default(false)
}

model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])
  targetType String // doctor | pharmacy | user
  targetId   String
  reason     String @db.Text
  status     String @default("open")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String
  createdAt DateTime @default(now())
}

// ── AI assistant (§8: interaction log required) ───────────────────
model AiSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  messages  AiMessage[]
}

model AiMessage {
  id        String    @id @default(cuid())
  sessionId String
  session   AiSession @relation(fields: [sessionId], references: [id])
  role      String    // user | assistant
  content   String    @db.Text
  flagged   Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model Schedule {
  id       String @id @default(cuid())
  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])
  weekday  Int // 0-6
  startAt  String // "10:00"
  endAt    String
  mode     String

  @@index([doctorId, weekday])
}

// ── OTP codes (hashed, short-lived, single-use) ───────────────────
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

// ── User preferences & in-app notifications ───────────────────────
model UserSettings {
  userId                 String  @id
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale                 String  @default("bn")
  appointmentAlerts      Boolean @default(true)
  refillAlerts           Boolean @default(true)
  reportAlerts           Boolean @default(true)
  emergencyAlerts        Boolean @default(true)
  smsAlerts              Boolean @default(false)
  shareRecords           Boolean @default(true)
  sharePrescriptions     Boolean @default(true)
  updatedAt              DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  type      String   @default("system")
  dedupeKey String?  @unique
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ── Family profiles ─────────────────────────────────────────────────
model FamilyMember {
  id             String   @id @default(cuid())
  patientId      String
  patient        User     @relation("FamilyPatient", fields: [patientId], references: [id], onDelete: Cascade)
  name           String
  bloodGroup     String?
  dateOfBirth    DateTime?
  relationship   String   // spouse | child | parent | other
  hasOwnLogin    Boolean  @default(false)
  linkedUserId   String?  @unique
  linkedUser     User?    @relation("FamilyLinkedUser", fields: [linkedUserId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
}

// ── Lab tests & bookings ────────────────────────────────────────────
model LabTest {
  id          String   @id @default(cuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id])
  name        String
  description String?  @db.Text
  price       Int
  duration    String   // e.g., "15 min"
  requiresFasting Boolean @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labId])
}

model LabBooking {
  id             String         @id @default(cuid())
  patientId      String
  patient        User           @relation(fields: [patientId], references: [id])
  labId          String
  lab            Lab            @relation(fields: [labId], references: [id])
  testIds        String[]
  slot           DateTime
  status         LabBookingStatus @default(BOOKED)
  homeCollection Boolean        @default(false)
  address        String?
  lat            Decimal?       @db.Decimal(9, 6)
  lng            Decimal?       @db.Decimal(9, 6)
  totalPrice     Int
  paymentId      String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  report         LabReport?

  @@index([patientId])
  @@index([labId])
}

enum LabBookingStatus {
  BOOKED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

model LabReport {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  booking       LabBooking @relation(fields: [bookingId], references: [id])
  fileUrl       String
  aiSummary     String?  @db.Text
  uploadedBy    String
  uploadedAt    DateTime @default(now())
}

// ── Pharmacy orders & dispense ──────────────────────────────────────
model PharmacyOrder {
  id             String             @id @default(cuid())
  prescriptionId String             @unique
  prescription   Prescription       @relation(fields: [prescriptionId], references: [id])
  pharmacyId     String
  pharmacy       Pharmacy           @relation(fields: [pharmacyId], references: [id])
  patientId      String
  patient        User               @relation(fields: [patientId], references: [id])
  status         PharmacyOrderStatus @default(RECEIVED)
  notes          String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  dispenseLogs   PharmacyDispenseLog[]

  @@index([pharmacyId])
  @@index([patientId])
}

enum PharmacyOrderStatus {
  RECEIVED
  VERIFIED
  PREPARING
  READY_FOR_PICKUP
  DISPENSED
  CANCELLED
}

model PharmacyDispenseLog {
  id           String   @id @default(cuid())
  orderId      String
  order        PharmacyOrder @relation(fields: [orderId], references: [id])
  itemId       String
  quantity     Int
  dispensedBy  String
  dispensedAt  DateTime @default(now())
}

// ── Ambulance ───────────────────────────────────────────────────────
model Ambulance {
  id             String         @id @default(cuid())
  hospitalId     String
  hospital       Hospital       @relation(fields: [hospitalId], references: [id])
  vehicleNumber  String         @unique
  type           String         // BLS | ALS | ICU
  status         AmbulanceStatus @default(AVAILABLE)
  currentLat     Decimal?       @db.Decimal(9, 6)
  currentLng     Decimal?       @db.Decimal(9, 6)
  driverName     String?
  driverPhone    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bookings       AmbulanceBooking[]

  @@index([hospitalId])
}

enum AmbulanceStatus {
  AVAILABLE
  ON_DUTY
  MAINTENANCE
  OFFLINE
}

model AmbulanceBooking {
  id            String               @id @default(cuid())
  patientId     String
  patient       User                 @relation(fields: [patientId], references: [id])
  ambulanceId   String?
  ambulance     Ambulance?           @relation(fields: [ambulanceId], references: [id])
  pickupLat     Decimal              @db.Decimal(9, 6)
  pickupLng     Decimal              @db.Decimal(9, 6)
  dropoffLat    Decimal              @db.Decimal(9, 6)
  dropoffLng    Decimal              @db.Decimal(9, 6)
  pickupAddress String
  dropoffAddress String
  urgency       String               // routine | urgent | critical
  status        AmbulanceBookingStatus @default(REQUESTED)
  assignedAt    DateTime?
  pickedUpAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([patientId])
  @@index([ambulanceId])
}

enum AmbulanceBookingStatus {
  REQUESTED
  ASSIGNED
  EN_ROUTE_PICKUP
  PICKED_UP
  EN_ROUTE_DROPOFF
  COMPLETED
  CANCELLED
}

// ── Hospital queue (realtime) ───────────────────────────────────────
model QueueTicket {
  id            String        @id @default(cuid())
  hospitalId    String
  hospital      Hospital      @relation(fields: [hospitalId], references: [id])
  patientId     String
  patient       User          @relation("PatientQueueTickets", fields: [patientId], references: [id])
  doctorId      String?
  doctor        Doctor?       @relation(fields: [doctorId], references: [id])
  serialNumber  Int
  status        QueueStatus   @default(WAITING)
  calledAt      DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([hospitalId, serialNumber])
  @@index([hospitalId, status])
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

// ── Consultation messages (chat during consultation) ────────────────
model ConsultationMessage {
  id             String   @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id])
  content        String   @db.Text
  type           String   @default("text") // text | image | file | system
  createdAt      DateTime @default(now())

  @@index([consultationId])
}

// ── Prescription refill requests ────────────────────────────────────
model RefillRequest {
  id             String           @id @default(cuid())
  prescriptionId String
  prescription   Prescription     @relation(fields: [prescriptionId], references: [id])
  patientId      String
  patient        User             @relation(fields: [patientId], references: [id])
  pharmacyId     String?
  pharmacy       Pharmacy?        @relation(fields: [pharmacyId], references: [id])
  status         RefillStatus     @default(PENDING)
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([patientId])
  @@index([prescriptionId])
}

enum RefillStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

// ── Push notification tokens (FCM/APNs) ─────────────────────────────
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // ios | android | web
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Contact messages ────────────────────────────────────────────────
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("new")
  createdAt DateTime @default(now())
}
